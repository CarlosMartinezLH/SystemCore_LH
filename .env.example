# ==============================================================================
# LanAhora SystemCore - Variables de Entorno de Ejemplo
# ==============================================================================
# Copia este archivo a .env.local ejecutando en Windows (CMD / PowerShell):
#   copy .env.example .env.local
# ==============================================================================

# Puerto de ejecución local (Next.js)
PORT=3000

# Secreto Criptográfico Institucional para Firma de Sesiones JWT (HMAC-SHA256)
JWT_SECRET=genera_un_secreto_criptografico_seguro_de_64_caracteres_hex

# Perímetro y Sinergia Cloudflare Zero Trust
ENFORCE_CLOUDFLARE_ZERO_TRUST=false
CLOUDFLARE_ZERO_TRUST_TEAM=lanahora

# Credenciales de Servicio Nubarium (Validación Oficial CURP / RENAPO / Biometría)
NUBARIUM_USERNAME=tu_usuario_nubarium
NUBARIUM_PASSWORD=tu_contraseña_nubarium

# Llaves WebPush VAPID para Notificaciones Móviles
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@lanahora.com.mx

# Servidor de Identidad Keycloak (IAM OIDC)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=lanahora
KEYCLOAK_CLIENT_ID=systemcore-web
KEYCLOAK_CLIENT_SECRET=systemcore_keycloak_secret_2026

# ==============================================================================
# Configuración de Envío Real de Correo (SMTP / Nodemailer)
# ==============================================================================
# Para Google Workspace / Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tu_correo@lanahora.com
#   SMTP_PASS=tu_contraseña_de_aplicacion_google (16 caracteres generada en tu cuenta)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LanAhora Seguridad" <seguridad@lanahora.com>

