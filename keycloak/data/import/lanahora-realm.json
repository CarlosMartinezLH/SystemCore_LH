{
  "id": "lanahora",
  "realm": "lanahora",
  "displayName": "Financiera LanAhora",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>LanAhora</span> SystemCore</div>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "DIRECTOR_GENERAL",
        "description": "Acceso total institucional a todas las sucursales y operaciones"
      },
      {
        "name": "MESA_CREDITO",
        "description": "Dictaminación de riesgos, SAT 69-B, Buró y validación de pagarés"
      },
      {
        "name": "COORDINADOR_COMERCIAL",
        "description": "Supervisión operativa y carteras de su sucursal asignada"
      },
      {
        "name": "ASESOR_CAMPO",
        "description": "Prospección y originación digital en ruta"
      },
      {
        "name": "ADMIN",
        "description": "Administrador técnico de SystemCore"
      }
    ]
  },
  "defaultRoles": ["offline_access", "uma_authorization"],
  "clients": [
    {
      "clientId": "systemcore-web",
      "name": "SystemCore Web Platform",
      "description": "Plataforma central web Next.js",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "systemcore_keycloak_secret_2026",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "sucursal-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "sucursal",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "sucursal",
            "jsonType.label": "String"
          }
        },
        {
          "name": "scope-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "scope",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "scope",
            "jsonType.label": "String"
          }
        },
        {
          "name": "puesto-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
